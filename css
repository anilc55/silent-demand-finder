
body{
  font-family: Arial;
  background:#0f172a;
  color:#e5e7eb;
  padding:20px;
}
.container{
  max-width:500px;
  margin:auto;
}
h1{
  color:#22c55e;
  text-align:center;
}
input,button{
  width:100%;
  padding:12px;
  margin:10px 0;
  border-radius:6px;
  border:none;
}
button{
  background:#22c55e;
  font-weight:bold;
  cursor:pointer;
}
.card{
  background:#020617;
  padding:12px;
  border-left:4px solid #22c55e;
  margin-top:10px;
  border-radius:6px;
}
.tag{
  color:#22c55e;
  font-size:12px;
}
