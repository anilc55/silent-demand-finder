body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f4f6f5;
}

/* TOP NAV */
.top-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #111;
  color: #00ff7f;
  padding: 12px 16px;
  position: relative;
}

.logo {
  font-size: 20px;
  font-weight: bold;
}

.menu-toggle {
  font-size: 26px;
  cursor: pointer;
  display: block;
}

#menu {
  display: none;
  position: absolute;
  top: 55px;
  right: 10px;
  background: #000;
  border-radius: 10px;
  overflow: hidden;
}

#menu a {
  display: block;
  padding: 12px 18px;
  color: #00ff7f;
  text-decoration: none;
  border-bottom: 1px solid #222;
}

#menu a:hover {
  background: #00ff7f;
  color: #000;
}

/* HERO */
.hero {
  background: linear-gradient(135deg, #000, #0f2027);
  color: #00ff7f;
  text-align: center;
  padding: 30px 15px;
}

/* SEARCH */
.search-box {
  background: #0b0b0b;
  margin: 20px;
  padding: 20px;
  border-radius: 15px;
  box-shadow: 0 0 20px rgba(0,255,127,0.3);
}

.search-box input {
  width: 100%;
  padding: 12px;
  border-radius: 10px;
  border: none;
  font-size: 16px;
}

.search-box button {
  width: 100%;
  margin-top: 12px;
  padding: 14px;
  background: #00ff7f;
  color: #000;
  border: none;
  font-size: 18px;
  font-weight: bold;
  border-radius: 10px;
  cursor: pointer;
}

/* RESULT CARDS */
#results {
  padding: 10px;
}

.card {
  background: linear-gradient(135deg, #020024, #090979, #00d4ff);
  color: #00ff7f;
  margin: 15px;
  padding: 18px;
  border-radius: 16px;
  box-shadow: 0 0 15px rgba(0,255,127,0.4);
}

.card h3 {
  margin-top: 0;
}

/* FOOTER */
footer {
  background: #000;
  color: #00ff7f;
  text-align: center;
  padding: 12px;
  margin-top: 30px;
}
