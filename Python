# data_collector.py
import asyncio
from typing import List, Dict
import aiohttp
from bs4 import BeautifulSoup
import googleapiclient.discovery

class DataCollector:
    def __init__(self):
        self.sources = {
            'google_autocomplete': self._get_google_autocomplete,
            'youtube_comments': self._get_youtube_comments,
            'reddit_posts': self._get_reddit_data,
            'quora_questions': self._get_quora_data,
            'amazon_reviews': self._get_amazon_reviews
        }
    
    async def collect_all_sources(self, keyword: str) -> Dict:
        tasks = []
        for source_name, source_func in self.sources.items():
            task = asyncio.create_task(
                source_func(keyword, source_name)
            )
            tasks.append(task)
        
        results = await asyncio.gather(*tasks, return_exceptions=True)
        return self._process_results(results)
